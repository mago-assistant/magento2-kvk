<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="mago">
            <group id="kvk" translate="label" type="text" sortOrder="900" showInDefault="1">
                <label>KVK Lookup</label>
                <field id="kvk_attribute" translate="label comment" type="text" sortOrder="10" showInDefault="1">
                    <label>KVK Number Attribute</label>
                    <comment>Attribute code that holds the KVK number, read from the order billing address first and the customer second. Leave empty when the shop does not store one; the assistant then needs the number itself.</comment>
                    <validate>validate-code</validate>
                </field>
                <field id="cache_days" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Cache Lifetime (days)</label>
                    <comment>The KVK open dataset allows one request per minute per server, so answers are cached.</comment>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
